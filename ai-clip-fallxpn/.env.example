####################################
# Core
####################################
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

####################################
# Database & queue
####################################
DATABASE_URL=postgresql://ai_clipflow:ai_clipflow@localhost:5432/ai_clipflow
REDIS_URL=redis://localhost:6379

####################################
# Auth & secrets
# SESSION_SECRET: run `openssl rand -hex 32`
# ENCRYPTION_KEY: run `openssl rand -hex 32` (used for AES-256-GCM, must be 32 bytes / 64 hex chars)
####################################
SESSION_SECRET=replace-with-openssl-rand--hex-32
ENCRYPTION_KEY=replace-with-openssl-rand--hex-32

####################################
# Storage: local | s3 | r2 | minio
# (r2 and minio both speak the S3 API — same client, different endpoint)
####################################
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ai-clipflow
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL for reading back objects (CDN domain, R2 public bucket URL, etc.)
S3_PUBLIC_URL=

####################################
# AI providers
# These are the *fallback* defaults read at boot. Once the Admin Panel
# (Phase 2) ships, provider config is stored encrypted in the database and
# overrides these. See src/lib/ai/index.ts.
#
# Check https://ai.google.dev/gemini-api/docs/models for the current model
# catalog before deploying — model names are renamed/retired over time.
####################################
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_TEMPERATURE=0.7
CUSTOM_AI_MAX_TOKENS=8192
CUSTOM_AI_TIMEOUT_MS=60000

# Which provider is active: gemini | custom
AI_PROVIDER=gemini

####################################
# Transcription (word-level timestamps for karaoke-style subtitles)
# Runs on the worker/VPS, never inside a serverless function.
# If WHISPER_SERVICE_URL is set, the worker calls that HTTP service
# (e.g. a self-hosted faster-whisper server). Otherwise it shells out to a
# local binary at WHISPER_BINARY_PATH.
####################################
WHISPER_SERVICE_URL=
WHISPER_BINARY_PATH=whisper
WHISPER_MODEL=medium

####################################
# FFmpeg / yt-dlp binaries (must be installed on the worker host/image)
####################################
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

####################################
# TikTok Content Posting API (official, OAuth-based — see src/lib/tiktok)
# Register an app at https://developers.tiktok.com, add the "Login Kit" and
# "Content Posting API" products, and request the video.publish, video.upload
# and user.info.basic scopes.
# NOTE: TikTok rejects redirect URIs on localhost/127.0.0.1/*.local — use a
# tunnel (e.g. Cloudflare Tunnel) for local development.
# NOTE: until your app passes TikTok's audit, all posts are forced to
# SELF_ONLY (private) visibility regardless of what the user picks. The UI
# surfaces this; it is a TikTok platform rule, not a bug.
####################################
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/oauth/callback

####################################
# Batch limits (admin-overridable defaults once Phase 2 ships)
####################################
DEFAULT_VIDEOS_PER_BATCH=40
MAX_VIDEOS_PER_BATCH=40
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_SEC=14400

####################################
# Rate limiting
####################################
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_HOUR=10

####################################
# Vercel (web app only — the worker runs elsewhere, see DEPLOY-VERCEL.md)
####################################
# - STORAGE_PROVIDER must be s3 or r2 (local disk does not work on Vercel).
# - DATABASE_URL: use the *pooled* connection string (e.g. Neon `-pooler` host,
#   add `?pgbouncer=true&connection_limit=1`).
# - REDIS_URL: a TCP URL (redis:// or rediss://), NOT an HTTP/REST URL.
# - NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_API_URL / TIKTOK_REDIRECT_URI must use your
#   https Vercel domain.
# - Your bucket needs a CORS rule allowing PUT from that domain (browser uploads).
# YOUTUBE_METADATA_MODE=oembed   # forced automatically on Vercel
