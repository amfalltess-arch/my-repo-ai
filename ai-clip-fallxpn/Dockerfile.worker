# AI ClipFlow — background worker (spec sections 35-36, 50)
# Runs all 12 BullMQ pipeline stages: FFmpeg rendering, Whisper transcription,
# TikTok publishing. Deploy this as a long-lived container/VPS process —
# never as a serverless function — since jobs are long-running and need a
# real local filesystem for scratch files (see src/lib/queue/work-dir.ts).

FROM node:20-slim

# ffmpeg for all video processing; python3+pip for yt-dlp and (optionally)
# openai-whisper if you're not using a separate WHISPER_SERVICE_URL.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    curl \
    openssl \
    ca-certificates \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* ./
# `postinstall` runs `prisma generate`, so the schema must be present first.
COPY prisma ./prisma
RUN npm install
COPY . .
RUN npx prisma generate

ENV NODE_ENV=production
ENV WORKER_TMP_DIR=/data/tmp
RUN mkdir -p /data/tmp

CMD ["npm", "run", "worker"]
